#version 460
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform texture2D textures[];
layout(set = 0, binding = 3) uniform sampler tex_sampler;
layout(set = 1, binding = 0, std430) buffer Result { uvec4 size; vec4 colour; } result;
layout(push_constant) uniform Push { uint texture_index; } pc;
void main() {
    sampler2D sampled_texture = sampler2D(textures[nonuniformEXT(pc.texture_index)], tex_sampler);
    result.size = uvec4(textureSize(sampled_texture, 0), 0, 0);
    result.colour = textureLod(sampled_texture, vec2(0.5), 0);
}
